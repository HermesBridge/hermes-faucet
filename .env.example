# Hermes faucet backend credentials (server-side only — never prefixed with VITE_)
# Copy this file to `.env` and set the real value there (or in your host's
# secret store). Never commit real secrets.
FAUCET_API_KEY=your-faucet-backend-api-key
# Optional override; defaults to the production backend URL.
FAUCET_API_BASE_URL=https://your-faucet-backend.example.com